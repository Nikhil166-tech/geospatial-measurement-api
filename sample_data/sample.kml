<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Survey Mission Alpha</name>
    <description>Drone aerial survey field and telemetry track</description>
    
    <!-- Survey Polygon -->
    <Placemark id="feature_poly_01">
      <name>Agricultural Survey Plot 1</name>
      <description>Target mapping parcel for drone multispectral inspection</description>
      <ExtendedData>
        <Data name="crop_type">
          <value>Wheat</value>
        </Data>
        <Data name="inspection_date">
          <value>2026-10-07</value>
        </Data>
      </ExtendedData>
      <Polygon>
        <outerBoundaryIs>
          <LinearRing>
            <coordinates>
              77.5900,12.9700,0
              77.5950,12.9700,0
              77.5950,12.9750,0
              77.5900,12.9750,0
              77.5900,12.9700,0
            </coordinates>
          </LinearRing>
        </outerBoundaryIs>
      </Polygon>
    </Placemark>

    <!-- Flight Transect LineString -->
    <Placemark id="feature_line_01">
      <name>Drone Flight Transect</name>
      <description>Linear autonomous flight trajectory</description>
      <ExtendedData>
        <Data name="flight_speed_mps">
          <value>12.5</value>
        </Data>
      </ExtendedData>
      <LineString>
        <coordinates>
          77.5900,12.9700,50
          77.5925,12.9725,50
          77.5950,12.9750,50
        </coordinates>
      </LineString>
    </Placemark>

    <!-- Ground Control Point -->
    <Placemark id="feature_point_01">
      <name>Base Station GCP 01</name>
      <description>RTK Base Station Ground Control Point</description>
      <ExtendedData>
        <Data name="elevation_m">
          <value>920.4</value>
        </Data>
      </ExtendedData>
      <Point>
        <coordinates>
          77.5910,12.9710,0
        </coordinates>
      </Point>
    </Placemark>

  </Document>
</kml>
